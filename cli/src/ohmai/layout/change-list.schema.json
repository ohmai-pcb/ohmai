{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OhmAI layout change list v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "base",
    "operations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "board_file",
        "sha256"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$"
        },
        "board_file": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "op": {
                "const": "via.add"
              },
              "net": {
                "type": "string",
                "minLength": 1
              },
              "at": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number"
                }
              },
              "diameter": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "drill": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "layers": {
                "const": [
                  "F.Cu",
                  "B.Cu"
                ]
              }
            },
            "required": [
              "id",
              "op",
              "net",
              "at",
              "diameter",
              "drill",
              "layers"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "op": {
                "const": "via.delete"
              },
              "uuid": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
              },
              "expect": {
                "$ref": "#/$defs/via"
              }
            },
            "required": [
              "id",
              "op",
              "uuid",
              "expect"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "op": {
                "const": "track.add"
              },
              "net": {
                "type": "string",
                "minLength": 1
              },
              "start": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number"
                }
              },
              "end": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number"
                }
              },
              "width": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "layer": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "op",
              "net",
              "start",
              "end",
              "width",
              "layer"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "op": {
                "const": "track.delete"
              },
              "uuid": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
              },
              "expect": {
                "$ref": "#/$defs/track"
              }
            },
            "required": [
              "id",
              "op",
              "uuid",
              "expect"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "op": {
                "const": "zone.add"
              },
              "net": {
                "type": "string",
                "minLength": 1
              },
              "layer": {
                "type": "string",
                "minLength": 1
              },
              "polygon": {
                "type": "array",
                "minItems": 3,
                "items": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "number"
                  }
                }
              },
              "priority": {
                "type": "integer",
                "minimum": 0
              },
              "clearance": {
                "type": "number",
                "minimum": 0
              },
              "min_thickness": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "pad_connection": {
                "enum": [
                  "solid",
                  "thermal",
                  "none"
                ]
              },
              "thermal_gap": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "thermal_spoke": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "island_removal": {
                "enum": [
                  "always",
                  "never"
                ]
              },
              "name": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "op",
              "net",
              "layer",
              "polygon",
              "priority",
              "clearance",
              "min_thickness",
              "pad_connection",
              "island_removal"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "op": {
                "const": "zone.edit"
              },
              "uuid": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
              },
              "expect": {
                "$ref": "#/$defs/zone_partial"
              },
              "set": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "polygon": {
                    "type": "array",
                    "minItems": 3,
                    "items": {
                      "type": "array",
                      "minItems": 2,
                      "maxItems": 2,
                      "items": {
                        "type": "number"
                      }
                    }
                  },
                  "priority": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "clearance": {
                    "type": "number",
                    "minimum": 0
                  },
                  "min_thickness": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "pad_connection": {
                    "enum": [
                      "solid",
                      "thermal",
                      "none"
                    ]
                  },
                  "thermal_gap": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "thermal_spoke": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "island_removal": {
                    "enum": [
                      "always",
                      "never"
                    ]
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [],
                "minProperties": 1
              },
              "match": {
                "enum": [
                  "geometry",
                  "uuid"
                ],
                "description": "geometry (default): expect must give net, layer and polygon. uuid: the UUID plus the base-commit fingerprint identify the zone; expect is optional and may be partial."
              },
              "polygon_tolerance": {
                "type": "number",
                "minimum": 0,
                "maximum": 0.1,
                "description": "Per-coordinate tolerance (mm) when comparing expect.polygon; default 0.005."
              }
            },
            "required": [
              "id",
              "op",
              "uuid",
              "set"
            ],
            "if": {
              "not": {
                "required": [
                  "match"
                ],
                "properties": {
                  "match": {
                    "const": "uuid"
                  }
                }
              }
            },
            "then": {
              "required": [
                "expect"
              ],
              "properties": {
                "expect": {
                  "$ref": "#/$defs/zone"
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "op": {
                "const": "zone.delete"
              },
              "uuid": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
              },
              "expect": {
                "$ref": "#/$defs/zone_partial"
              },
              "match": {
                "enum": [
                  "geometry",
                  "uuid"
                ],
                "description": "geometry (default): expect must give net, layer and polygon. uuid: the UUID plus the base-commit fingerprint identify the zone; expect is optional and may be partial."
              },
              "polygon_tolerance": {
                "type": "number",
                "minimum": 0,
                "maximum": 0.1,
                "description": "Per-coordinate tolerance (mm) when comparing expect.polygon; default 0.005."
              }
            },
            "required": [
              "id",
              "op",
              "uuid"
            ],
            "if": {
              "not": {
                "required": [
                  "match"
                ],
                "properties": {
                  "match": {
                    "const": "uuid"
                  }
                }
              }
            },
            "then": {
              "required": [
                "expect"
              ],
              "properties": {
                "expect": {
                  "$ref": "#/$defs/zone"
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "op": {
                "const": "footprint.move"
              },
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "expect": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "at": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "type": "number"
                    }
                  },
                  "rotation": {
                    "type": "number"
                  }
                },
                "required": [
                  "at",
                  "rotation"
                ]
              },
              "to": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number"
                }
              }
            },
            "required": [
              "id",
              "op",
              "ref",
              "expect",
              "to"
            ]
          }
        ]
      }
    }
  },
  "$defs": {
    "via": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "net": {
          "type": "string",
          "minLength": 1
        },
        "at": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number"
          }
        },
        "diameter": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "drill": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "layers": {
          "const": [
            "F.Cu",
            "B.Cu"
          ]
        }
      },
      "required": [
        "net",
        "at",
        "diameter",
        "drill",
        "layers"
      ]
    },
    "track": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "net": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number"
          }
        },
        "end": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number"
          }
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "layer": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "net",
        "start",
        "end",
        "width",
        "layer"
      ]
    },
    "zone": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "net": {
          "type": "string",
          "minLength": 1
        },
        "layer": {
          "type": "string",
          "minLength": 1
        },
        "polygon": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number"
            }
          }
        },
        "priority": {
          "type": "integer",
          "minimum": 0
        },
        "clearance": {
          "type": "number",
          "minimum": 0
        },
        "min_thickness": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "pad_connection": {
          "enum": [
            "solid",
            "thermal",
            "none"
          ]
        },
        "thermal_gap": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "thermal_spoke": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "island_removal": {
          "enum": [
            "always",
            "never"
          ]
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "net",
        "layer",
        "polygon"
      ]
    },
    "zone_partial": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "net": {
          "type": "string",
          "minLength": 1
        },
        "layer": {
          "type": "string",
          "minLength": 1
        },
        "polygon": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number"
            }
          }
        },
        "priority": {
          "type": "integer",
          "minimum": 0
        },
        "clearance": {
          "type": "number",
          "minimum": 0
        },
        "min_thickness": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "pad_connection": {
          "enum": [
            "solid",
            "thermal",
            "none"
          ]
        },
        "thermal_gap": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "thermal_spoke": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "island_removal": {
          "enum": [
            "always",
            "never"
          ]
        },
        "name": {
          "type": "string"
        }
      },
      "description": "Zone expect checked in match \"uuid\" mode: any subset of zone fields; polygon (if given) is still compared."
    }
  }
}
