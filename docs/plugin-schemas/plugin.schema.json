{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OhmAI supported plugin metadata subset (documented Grok/Claude contracts)",
  "type": "object",
  "required": [
    "name",
    "version",
    "description",
    "author",
    "skills",
    "license",
    "homepage",
    "repository"
  ],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "description": {
      "type": "string",
      "minLength": 20
    },
    "author": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        }
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\./skills/ohmai$"
      },
      "minItems": 1,
      "maxItems": 1
    },
    "license": {
      "const": "Apache-2.0"
    },
    "homepage": {
      "type": "string",
      "format": "uri"
    },
    "repository": {
      "type": "string",
      "format": "uri"
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
